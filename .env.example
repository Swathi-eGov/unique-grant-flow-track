# Copy this to .env and fill in real values before running docker-compose

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=changeme_in_production

# JWT — must be at least 256 bits (32 chars). Generate with:
#   openssl rand -hex 32
JWT_SECRET=186c01396b0585373f5c3d762e4897ca3c1398e66e253cb561bcfd6267e23bf1

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend — backend URL (used at build time by Vite)
VITE_API_BASE_URL=http://localhost:8080
