{
  "name": "MSA",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title, e.g. MSA with BAO Systems"
    },
    "vendor_name": {
      "type": "string",
      "description": "Name of the service provider / second party"
    },
    "msa_number": {
      "type": "string",
      "description": "MSA reference number"
    },
    "vendor_address": {
      "type": "string"
    },
    "vendor_contact_name": {
      "type": "string"
    },
    "vendor_contact_email": {
      "type": "string"
    },
    "our_contact_name": {
      "type": "string"
    },
    "our_contact_email": {
      "type": "string"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "initial_term_years": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "draft",
        "terminated"
      ],
      "default": "active"
    },
    "governing_law": {
      "type": "string",
      "description": "Governing law jurisdiction"
    },
    "auto_renew": {
      "type": "boolean",
      "default": false,
      "description": "Whether the MSA auto-renews"
    },
    "notice_period": {
      "type": "string",
      "description": "Notice period required to terminate, e.g. 30 days"
    },
    "liability_cap": {
      "type": "string",
      "description": "Cap on liability, e.g. 12 months fees"
    },
    "ip_ownership": {
      "type": "string",
      "description": "IP ownership terms"
    },
    "description": {
      "type": "string"
    },
    "key_terms": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "vendor_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}