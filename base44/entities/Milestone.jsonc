{
  "name": "Milestone",
  "type": "object",
  "properties": {
    "grant_id": {
      "type": "string",
      "description": "Reference to the parent grant"
    },
    "title": {
      "type": "string",
      "description": "Milestone name or description"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount for this milestone"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Date the milestone was actually paid"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "invoiced",
        "paid",
        "overdue"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "grant_id",
    "title",
    "due_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}